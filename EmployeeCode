
package Code;

    
    
class EmployeeCode {
    private String name;
    private String department;
    private int year;

    
    public EmployeeCode(String name, String department, int year) {
        this.name = name;
        this.department = department;
        this.year = year;
    }

    
    public String generateCode() {
        StringBuilder sb = new StringBuilder();

       
        sb.append(name.substring(0, 3).toUpperCase());
        sb.append("-");

        
        sb.append(department.substring(0, 3));
        sb.append("-");

        
        sb.append(year);

        return sb.toString();
    }
}


public class CodeGenerator {
    public static void main(String[] args) {

        
        String name = "Prasanth";
        String department = "Java";
        int year = 2026;

        System.out.println("Name: " + name);
        System.out.println("Department: " + department);
        System.out.println("Year: " + year);

        
        EmployeeCode emp = new EmployeeCode(name, department, year);

        String code = emp.generateCode();
        System.out.println("Generated Code: " + code);
    }
}

