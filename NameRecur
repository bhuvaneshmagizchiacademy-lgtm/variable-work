class NameRecur {
    public static void main(String[] args)
	{

        String name = "BHUVANESH";
        NameRecur nr = new NameRecur();
        nr.printName(name, 1);
    }

    public void printName(String name, int count) 
	{
        if (count > 10) {
            return;
        }
		               
        System.out.println(name);
		
        printName(name, ++count);
    }
}
