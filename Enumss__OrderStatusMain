
package Enumss;


import java.util.Scanner;

public class OrderStatusMain {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        while (true) {

            System.out.println("\n1. Show Order Status");
            System.out.println("2. Check if Order is Completed");
            System.out.println("3. Exit");

            System.out.print("Enter choice: ");
            int choice = sc.nextInt();

            switch (choice) {

            case 1:
                System.out.print("Enter Status: ");

                OrderStatus status =
                        OrderStatus.valueOf(sc.next().toUpperCase());

                System.out.println("Order Status: " + status);
                break;

            case 2:
                System.out.print("Enter Status: ");

                OrderStatus status2 =
                        OrderStatus.valueOf(sc.next().toUpperCase());

                if (status2 == OrderStatus.DELIVERED)
                    System.out.println("Order Completed");
                else
                    System.out.println("Order Not Completed");

                break;

            case 3:
                System.out.println("Exit");
                return;

            default:
                System.out.println("Invalid Choice");
            }
        }
    }
}

