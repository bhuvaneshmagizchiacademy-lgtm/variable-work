
package list;

import java.util.Scanner;


public class Main {
    

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        EmployeeManager manager = new EmployeeManager();

        while (true) {

            System.out.println("\n===== EMPLOYEE PAYROLL =====");
            System.out.println("1. Add Employee");
            System.out.println("2. View All Employees");
            System.out.println("3. Search Employee");
            System.out.println("4. Update Basic Salary");
            System.out.println("5. Calculate Net Salary");
            System.out.println("6. Delete Employee");
            System.out.println("7. Exit");

            System.out.print("Enter your choice : ");
            int choice = sc.nextInt();

            switch (choice) {

                case 1 -> {
                    System.out.print("Enter Employee ID : ");
                    int id = sc.nextInt();

                    sc.nextLine();

                    System.out.print("Enter Employee Name : ");
                    String name = sc.nextLine();

                    System.out.print("Enter Department : ");
                    String department = sc.nextLine();

                    System.out.print("Enter Basic Salary : ");
                    double salary = sc.nextDouble();

                    Employee emp =
                            new Employee(id, name, department, salary);

                    manager.payroll.addEmployee(emp);
                }

                case 2 -> manager.payroll.viewEmployees();

                case 3 -> {
                    System.out.print("Enter Employee ID : ");
                    int id = sc.nextInt();
                    Employee e = manager.payroll.searchEmployee(id);
                    if (e != null) {
                        e.display();
                    } else {
                        System.out.println("Employee not found");
                    }
                }

                case 4 -> {
                    System.out.print("Enter Employee ID : ");
                    int id = sc.nextInt();
                    System.out.print("Enter New Basic Salary : ");
                    double salary = sc.nextDouble();
                    manager.updateSalary(id, salary);
                }

                case 5 -> {
                    System.out.print("Enter Employee ID : ");
                    int id = sc.nextInt();
                    manager.calculateSalary(id);
                }

                case 6 -> {
                    System.out.print("Enter Employee ID : ");
                    int id = sc.nextInt();
                    manager.deleteEmployee(id);
                }

                case 7 -> {
                    System.out.println("Thank You");
                    sc.close();
                    return;
                }

                default -> System.out.println("Invalid choice");
            }
        }
    }
}

