let sentence = "JavaScript is a programming language";

let totalCharacters = sentence.length;

let totalWords = sentence.trim().split(" ").length;

let lowerCase = sentence.toLowerCase();

let result = {
    characters: totalCharacters,
    words: totalWords,
    lowercase: lowerCase
};

console.log("QUESTION 2: WORD COUNT");
console.log("Total Characters: " + result.characters);
console.log("Total Words: " + result.words);
console.log("Lowercase: " + result.lowercase);




