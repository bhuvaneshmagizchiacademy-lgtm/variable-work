package Half;

public class HalfSum {
    

    public int sum(int[] a) {

        int sum = 0;

        for (int i = 0; i < (a.length + 1) / 2; i++) {
            sum = sum + a[i];
        }

        return sum;
    }

    public static void main(String[] args) {

        HalfSum obj = new HalfSum();

        int[] a = {1, 2, 3, 4, 5};

        int result = obj.sum(a);

        System.out.println(result);
    }
}

