class Loopps {
	
    public static void main(String[] args) {

        //WHILE LOOPS
		
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;;:");
        System.out.println("WHILE LOOPS:"); 
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;;:");
		
        for (int i = 1; i <= 10; i++) {
            System.out.println(i);
        }

        //FOR LOOPS
		
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;:");
        System.out.println("FOR LOOPS:");
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;:");
		
		
        int number = 987;
        int temp = number;
        int count = 0;

        while (temp != 0) {
            temp = temp / 10;
            count++;
        }

        System.out.println("Number = " + number);
        System.out.println("Number of digits = " + count);

        //do-while
		
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;:");
        System.out.println("DO-WHILE LOOPS:");
        System.out.println(";;;;;;;;;;;;;;;;;;;;;;;:");
		
        int num = 5;
        int j = 1;

        do {
            System.out.println(num + " x " + j + " = " + (num * j));
            j++;
        } while (j <= 10);
    }
}
