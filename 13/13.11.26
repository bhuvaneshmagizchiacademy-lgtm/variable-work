function calculate(marks) {
    if (marks >= 90) {
        return "A+";
    } 
    else if (marks >= 75) {
        return "A";
    } 
    else if (marks >= 60) {
        return "B";
    } 
    else if (marks >= 50) {
        return "C";
    } 
    else {
        return "Fail";
    }
}


console.log(calculate(95)); 
console.log(calculate(80)); 
console.log(calculate(65)); 
console.log(calculate(55));
console.log(calculate(40)); 
