class TableProject{
	
	
    public static void main(String[] args) {
		
        int[] nums = {2, 5};
		
        for (int num : nums) {
            for (int i = 1; i <= 10; i++) {
				
				
                System.out.println(num + " x " + i + " = " + (num * i));
            }
            System.out.println();
        }
    }
}
