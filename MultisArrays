class MultisArrays {
	
    public static void main(String[] args) {
		
        // 2D array
        String[][] fruits = {
            {"Apple", "100", "5"},
            {"Banana", "40", "12"},
            {"Mango", "80", "8"},
            {"Grapes", "60", "3"}
        };

        // Nested loop
        System.out.println("Fruit Store Details:");
        System.out.println("---------------------------------");
        System.out.printf("%-10s %-10s %-10s%n", "Name", "Price", "Qty");
        System.out.println("---------------------------------");

        for (int i = 0; i < fruits.length; i++) {
            for (int j = 0; j < fruits[i].length; j++) {
                System.out.printf("%-10s", fruits[i][j]);
            }
            System.out.println();
        }

        System.out.println("---------------------------------");

        // Total amount 
        int total = 0;
        for (int i = 0; i < fruits.length; i++) {
            int price = Integer.parseInt(fruits[i][1]);
            int qty = Integer.parseInt(fruits[i][2]);
            total += price * qty;
        }
        System.out.println("Total Amount: Rs." + total);
    }
}
