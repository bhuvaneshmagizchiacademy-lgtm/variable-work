import java.util.Scanner;

class Revsion2 {
    public static void main(String[] args) {
        Scanner Bhuvan = new Scanner(System.in);

        //if-else
        System.out.print("Enter your age: ");
        int age = Bhuvan.nextInt();

        if (age < 13) {
            System.out.println("You are a Child");
        } else if (age < 20) {
            System.out.println("You are a young man");
        } else {
            System.out.println("You are an mature person");
        }

        //switch
        System.out.print("Enter your day (1-7): ");
        int day = Bhuvan.nextInt();

        switch (day) {
            case 1 -> System.out.println("Monday");
            case 2 -> System.out.println("Tuesday");
            case 3 -> System.out.println("Wednesday");
            case 4 -> System.out.println("Thursday");
            case 5 -> System.out.println("Friday");
            case 6 -> System.out.println("Saturday");
            case 7 -> System.out.println("Sunday");
            default -> System.out.println("vera day illa sir");
        }

        Bhuvan.close();
    }
}
