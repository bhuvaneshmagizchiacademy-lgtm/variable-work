<!DOCTYPE html>
<html>
<head>
<title>Login Page</title>

<style>

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    height: 550px;
    display: grid;
  align-items: center;
  justify-content: center;
    font-family: Arial;
}


body::before {
    content: "";
    position: fixed;
    inset: 0;
    background: url("pampan balam.jpeg") center/cover;
    filter: blur(5px);
    z-index: -1;
}

.login-box {
    width: 500px;
    padding: 40px;
    background: rgba(255, 255, 255, 0.282);
    border-radius: 15px;
    box-shadow: 0px 0px 15px gray;
    display: grid;
    gap: 20px;
}


h2 {
    text-align: center;
    margin-bottom: 15px;
}

input {
    width: 100%;
    padding: 15px;
    border-radius: 15px;
    border: none;
    outline: none;
    background: white;
}

button {
    width: 150px;
    padding: 12px;
    background: rgba(62, 48, 219, 0.743);
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    justify-self: center;
}

button:hover {
    background: rgb(189, 72, 240);
    
}

</style>
</head>

<body>

<div class="login-box">

    <h2>Login</h2>

    <input type="text" placeholder="Username">

    <input type="password" placeholder="Password">

    <button>Login</button>

</div>


</body>
</html>
