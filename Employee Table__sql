SELECT * FROM Employee;

-- 11. Display Backup Table
SELECT * FROM backup;


-- 12. Update Employee Salary
UPDATE Employee
SET salary = 20000
WHERE emp_id = 101;

-- 13. Display Updated Employee Table
SELECT * FROM Employee;


-- 14. Delete Employee
DELETE FROM Employee
WHERE emp_id = 102;

