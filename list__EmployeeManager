
package list;


    

public class EmployeeManager {

    Payroll payroll = new Payroll();

    public void updateSalary(int id, double salary) {

        Employee e = payroll.searchEmployee(id);

        if (e != null) {
            e.basicSalary = salary;
            System.out.println("Salary updated successfully");
        } else {
            System.out.println("Employee not found");
        }
    }

    public void calculateSalary(int id) {

        Employee e = payroll.searchEmployee(id);

        if (e != null) {
            System.out.println("Employee Name : " + e.employeeName);
            System.out.println("Net Salary : " + e.calculateNetSalary());
        } else {
            System.out.println("Employee not found");
        }
    }

    public void deleteEmployee(int id) {

        Employee e = payroll.searchEmployee(id);

        if (e != null) {
            payroll.employees.remove(e);
            System.out.println("Employee deleted successfully");
        } else {
            System.out.println("Employee not found");
        }
    }
}

    class payroll {

        public payroll() {
        }
    }

