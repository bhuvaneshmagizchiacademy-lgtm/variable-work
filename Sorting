import java.util.Scanner;

public class Sorting {

    // Bubble Sort 
    static int bubbleSort(int[] arr) {
        int n = arr.length;
        int passes = n - 1;

        for (int i = 0; i < n - 1; i++) {
            for (int j = 0; j < n - i - 1; j++) {
                if (arr[j] > arr[j + 1]) {
                    int temp = arr[j];
                    arr[j] = arr[j + 1];
                    arr[j + 1] = temp;
                }
            }
        }
        return passes;
    }

    // Merge Sort 
    static void merge(int[] arr, int l, int m, int r) {
        int n1 = m - l + 1;
        int n2 = r - m;

        int[] left = new int[n1];
        int[] right = new int[n2];

        for (int i = 0; i < n1; i++)
            left[i] = arr[l + i];
        for (int j = 0; j < n2; j++)
            right[j] = arr[m + 1 + j];

        int i = 0, j = 0, k = l;

        while (i < n1 && j < n2) {
            if (left[i] <= right[j])
                arr[k++] = left[i++];
            else
                arr[k++] = right[j++];
        }
        while (i < n1)
            arr[k++] = left[i++];
        while (j < n2)
            arr[k++] = right[j++];
    }

    static void mergeSort(int[] arr, int l, int r) {
        if (l < r) {
            int m = l + (r - l) / 2;
            mergeSort(arr, l, m);
            mergeSort(arr, m + 1, r);
            merge(arr, l, m, r);
        }
    }

    static void printArray(int[] arr) {
        StringBuilder sb = new StringBuilder();
        for (int num : arr)
            sb.append(num).append(" ");
        System.out.println(sb.toString().trim());
    }

    // ---------- Main ----------
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        // ===== Question 1 =====
        System.out.println(" Bubble Sort");
        int n1 = sc.nextInt();
        int[] arr1 = new int[n1];
        for (int i = 0; i < n1; i++)
            arr1[i] = sc.nextInt();

        int passes = bubbleSort(arr1);

        System.out.println("Sorted Array:");
        printArray(arr1);
        System.out.println("Number of Passes: " + passes);

        // ===== Question 2 =====
        System.out.println("\nMerge Sort");
        int n2 = sc.nextInt();
        int[] arr2 = new int[n2];
        for (int i = 0; i < n2; i++)
            arr2[i] = sc.nextInt();

        mergeSort(arr2, 0, n2 - 1);

        System.out.println("Sorted Array:");
        printArray(arr2);

        int mid = arr2[(n2 - 1) / 2];
        System.out.println("Middle Element: " + mid);

        sc.close();
    }
}
